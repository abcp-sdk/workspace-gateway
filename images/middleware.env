# Pinned SHARED MIDDLEWARE images mirrored into the workspace registry under the
# `agent-toolchain` namespace, so every tenant sees them via `list-oci-images`
# (default owner=agent-toolchain) and can reference them from `service-deploy`
# or as a sandbox base.
#
# Format: <name>:<upstream-ref>  (left = the internal image name, right = the
# exact upstream image to mirror — never a floating tag).
#
# Mirrored with a no-op `FROM <ref>` rebuild (see middleware.Dockerfile), so the
# upstream ENTRYPOINT/CMD/ENV/USER/EXPOSE/WORKDIR are preserved verbatim. Only
# runnable IMAGE manifests can be mirrored this way (not arbitrary OCI
# artifacts); multi-arch sources collapse to linux/amd64.
#
# Bump a version here, then run:  ./mirror-images.sh <name>
postgres:docker.io/library/postgres:18.6
redis:docker.io/library/redis:8.10.2
mariadb:docker.io/library/mariadb:13.0.2
nats:docker.io/library/nats:2.15.0
