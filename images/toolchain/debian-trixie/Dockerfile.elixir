# Toolchain image: Erlang/OTP + Elixir + Hex.
#
# Generic: the artifacts are pre-downloaded (fetch-artifacts.sh) and COPYed.
ARG BASE_IMAGE=toolchain-base:debian-trixie
FROM ${BASE_IMAGE}
COPY cache/OTP-29.1.tar.gz /tmp/otp.tar.gz
COPY cache/v1.20.4-otp-29.zip /tmp/elixir.zip
COPY cache/hex-2.5.1-otp-29.ez /opt/hex-archive/hex.ez
COPY cache/registry-public-key.pem /opt/registry-pub.pem
RUN mkdir -p /opt/erlang && tar -xzf /tmp/otp.tar.gz -C /opt/erlang --strip-components=1 && rm /tmp/otp.tar.gz \
 && (cd /opt/erlang && ./Install -minimal /opt/erlang) \
 && mkdir -p /opt/elixir && unzip -q /tmp/elixir.zip -d /opt/elixir && rm /tmp/elixir.zip
ENV PATH=/opt/erlang/bin:/opt/elixir/bin:$PATH
