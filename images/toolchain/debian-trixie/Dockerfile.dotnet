# Toolchain image: .NET SDK.
#
# Generic: the SDK tarball is pre-downloaded (fetch-artifacts.sh) and COPYed.
# libicu is an OS dependency (.NET needs a valid ICU for globalization).
ARG BASE_IMAGE=toolchain-base:debian-trixie
FROM ${BASE_IMAGE}
# Use a fast in-region mirror for the OS dependency, then restore the official
# Debian sources the base image ships (apt sources are only touched at build).
ARG APT_MIRROR=deb.debian.org
RUN set -eux; \
    . /etc/os-release; \
    cp /etc/apt/sources.list.d/debian.sources /tmp/debian.sources.bak; \
    printf 'Types: deb\nURIs: http://%s/debian\nSuites: %s %s-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n\nTypes: deb\nURIs: http://%s/debian-security\nSuites: %s-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n' \
        "$APT_MIRROR" "$VERSION_CODENAME" "$VERSION_CODENAME" "$APT_MIRROR" "$VERSION_CODENAME" > /etc/apt/sources.list.d/debian.sources; \
    apt-get -o Acquire::Retries=10 update; \
    apt-get -o Acquire::Retries=10 install -y --no-install-recommends libicu76; \
    rm -rf /var/lib/apt/lists/*; \
    mv /tmp/debian.sources.bak /etc/apt/sources.list.d/debian.sources
COPY cache/dotnet-sdk-10.0.401-linux-x64.tar.gz /tmp/dotnet.tar.gz
ENV DOTNET_ROOT=/opt/dotnet DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
RUN mkdir -p /opt/dotnet && tar -xzf /tmp/dotnet.tar.gz -C /opt/dotnet && rm /tmp/dotnet.tar.gz
ENV PATH=/opt/dotnet:$PATH
